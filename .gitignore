# Student work folder (keep their work local)
student-work/*
!student-work/.gitkeep

# Student lab files (only templates are tracked)
labs/*_lab.R
!labs/*_template.R

# R auxiliary files
.Rhistory
.Rdata
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# R environment files
.Renviron
.Rprofile

# Quarto auxiliary files
/.quarto/
*_cache/
*_files/
!docs/**/*_files/

# Compiled R files
*.Rcheck/
*.Rout
*.Rout.fail

# Package files
*.tar.gz

# macOS
*.DS_Store

# Windows
Thumbs.db

# Temporary files
*~
*.tmp
*.temp

# HTML preview files (keep docs/ for GitHub Pages)
_book/
